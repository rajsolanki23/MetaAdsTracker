# App Configuration
APP_NAME="Creative Leaderboard API"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# MongoDB Database URL (Local or MongoDB Atlas M0 free tier)
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="creative_leaderboard"

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://*.vercel.app"

# Cron trigger secret for external keep-alive pingers (e.g. Cron-Job.org)
CRON_SECRET="leaderboard-secret-cron-key"

# Background Sync Interval (hours)
SYNC_INTERVAL_HOURS=4
